# Copy to backend/.env and fill in.

# gemini | ollama | auto  (auto = gemini if GEMINI_API_KEY set, else ollama — see adapters/client.py)
MODEL_PROVIDER=auto

GEMINI_API_KEY=
OLLAMA_MODEL=qwen3-vl:4b

# Only needed for the router feature's cross-family access — never used in
# the B5 experiment core arms, see README trade-offs.
OPENROUTER_API_KEY=

# Copy to backend/.env and fill in.

# gemini | ollama | auto
MODEL_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local safety caps; adjust your personal limits in backend/.env if needed.
GEMINI_MAX_REQUESTS_PER_DAY=15
GEMINI_MAX_REQUESTS_PER_MINUTE=4

OLLAMA_MODEL=qwen3-vl:4b-instruct

# Optional; not used by the core B5 experiment arms.
OPENROUTER_API_KEY=

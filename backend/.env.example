# Copy to backend/.env and fill in.

# gemini | ollama | auto  (auto = gemini if GEMINI_API_KEY set, else ollama — see adapters/client.py)
MODEL_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Hard safety caps — deliberately below your dashboard's actual free-tier
# numbers (check yours at aistudio.google.com). Auto-routed requests
# downgrade to Ollama when these are hit; pinned experiment-harness
# requests fail loudly instead of silently substituting. See
# backend/quota_guard.py.
GEMINI_MAX_REQUESTS_PER_DAY=15
GEMINI_MAX_REQUESTS_PER_MINUTE=4

OLLAMA_MODEL=qwen3-vl:4b-instruct

# Only needed for the router feature's cross-family access — never used in
# the B5 experiment core arms, see README trade-offs.
OPENROUTER_API_KEY=
